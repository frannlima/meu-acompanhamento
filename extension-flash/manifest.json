{
  "manifest_version": 3,
  "name": "Meu Acompanhamento — Flash",
  "version": "0.3.0",
  "description": "Coleta de indicadores Flash na sessão aberta: lojas, grupos, produtos e trocas.",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage"
  ],
  "optional_host_permissions": [
    "https://frannlima.github.io/*",
    "https://flash.riachuelo.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120"
}
